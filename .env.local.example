# --- Blueprint mentoring platform ---
# Copy to .env.local and fill in. .env.local is gitignored.

# MongoDB (use the DEV database connection string locally)
# The TJSS dashboard adds two auto-created cache collections (tjss_fng,
# tjss_price) in this same database, no extra config needed. Its data sources
# (alternative.me Fear & Greed, Binance klines) are keyless.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="blueprint_dev"

# Local dev: serve the mentor app on plain http://localhost:3000
# (Google OAuth rejects *.localhost). Unset/remove in production.
DEV_AS_MENTOR="1"

# Better Auth (generate a secret: `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""
# Local dev uses plain localhost; production uses the real subdomain.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email for verification + password reset)
RESEND_API_KEY=""
# The verified "from" address Resend will send as
EMAIL_FROM="The Blueprint <noreply@thomas-johnston.com>"

# Analytics / ad tracking (mentor site only). Leave blank to disable,
# the scripts no-op when unset.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""

# Comma-separated emails allowed to view the /admin creator dashboard
ADMIN_EMAILS=""

# Discord community pilot (no automatic Mentor account creation).
# Feature remains disabled until all setup checks pass.
COMMUNITY_VERIFICATION_ENABLED="false"
COMMUNITY_ENV="test"
# Generate with openssl rand -base64 32. Keep stable while verification flows are active.
COMMUNITY_VERIFICATION_SECRET=""
COMMUNITY_TEST_RECIPIENTS=""
DISCORD_GUILD_ID="1556786037307613317"
DISCORD_VERIFIED_ROLE_ID=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/discord/connect/callback"
DISCORD_INVITE_URL=""
# Optional guard: the real community's guild must not be used in test mode.
COMMUNITY_PRODUCTION_GUILD_ID="907092260632535040"
# Separate Full access key. Keep the existing send-only RESEND_API_KEY above.
RESEND_CONTACTS_API_KEY=""
RESEND_COMMUNITY_SEGMENT_ID=""
# Discord recovery only: generate a separate secret of at least 32 characters.
COMMUNITY_PROCESS_SECRET=""
# Shared Discord entrypoint. Public key verifies signed HTTP interactions (not a credential).
DISCORD_PUBLIC_KEY=""
DISCORD_VERIFY_CHANNEL_ID=""
